{
  "info": {
    "_postman_id": "d3a7c1e2-5b6f-4c8a-9e1d-2f7b4a8c6d5e",
    "name": "Aruba Conductor API",
    "description": "Scratch collection for testing the on-prem Aruba Conductor (AOS 8/10 Mobility Conductor) REST API. Uses the classic login -> UIDARUBA token -> showcommand -> logout flow. Not related to Aruba Central's cloud API, which uses a different (OAuth2) auth model. Pair with the 'Aruba Conductor' environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let data;",
              "try {",
              "    data = pm.response.json();",
              "} catch (e) {",
              "    data = null;",
              "}",
              "",
              "const token = data && data._global_result && data._global_result.UIDARUBA;",
              "",
              "pm.test('response is JSON with a UIDARUBA token', function () {",
              "    pm.expect(token, 'response was: ' + pm.response.text().slice(0, 300)).to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (token) {",
              "    pm.environment.set('token', token);",
              "    console.log('Saved UIDARUBA token to the environment.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "username", "value": "{{username}}", "type": "text" },
            { "key": "password", "value": "{{password}}", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/v1/api/login",
          "host": ["{{base_url}}"],
          "path": ["v1", "api", "login"]
        }
      },
      "response": []
    },
    {
      "name": "Show Command (template)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/configuration/showcommand?command=show switches&UIDARUBA={{token}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "configuration", "showcommand"],
          "query": [
            { "key": "command", "value": "show switches" },
            { "key": "UIDARUBA", "value": "{{token}}" }
          ]
        },
        "description": "Duplicate this request per command you want to test (e.g. 'show ap database long'). Swap the 'command' query param value; UIDARUBA is already wired to the token the Login request saved."
      },
      "response": []
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/v1/api/logout?UIDARUBA={{token}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "api", "logout"],
          "query": [{ "key": "UIDARUBA", "value": "{{token}}" }]
        }
      },
      "response": []
    }
  ]
}
